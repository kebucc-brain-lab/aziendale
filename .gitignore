# .gitignore del brain (Brain Builder v3.1). Generato da nuovo_brain.py.

# --- segreti e configurazioni locali: mai nel repo, mai nel RAG ---
.env
.env.*
!.env.example
.secrets/
.mcp.json
CLAUDE.local.md
.claude/settings.local.json
# .codex/ NON e' ignorata: hooks.json appartiene al brain. config.toml puo' contenere trust e segreti.
.codex/config.toml

# --- memoria automatica (autoMemoryDirectory) e ambienti locali ---
.memory/
# dream (v3.2): le proposte citano frasi delle sessioni, i backup sono copie della memoria: mai nel repo
# (`**/` serve: con uno slash interno la regola sarebbe ancorata alla radice e non coprirebbe i nodi)
**/workspace/dream/
.memory-backup/
# travaso (v3.3, SPEC v3.3 par. 5.3 e 14.1): esiti del travaso e pacchetti di verifica con estratti del canon aziendale: mai nel repo
**/workspace/travaso/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
node_modules/
.tmp/

# --- ops/ (v3.2.1, SPEC v3.2 par. 13.2): lavoro operativo versionato, ma fuori da git cio' che e' grande,
#     rigenerabile, privato o di terzi. `**/ops/` copre la radice e i nodi. `.env*` resta ignorato ovunque
#     (regole in testa), `.env.example` ammesso. Dati personali/di terzi: una regola per file, col motivo sopra. ---
# dipendenze npm/pnpm/yarn: rigenerabili con l'install
**/ops/**/node_modules/
# build di Next.js: rigenerabile
**/ops/**/.next/
# stato locale della CLI Vercel (link al progetto, a volte token): mai nel repo
**/ops/**/.vercel/
# output di build: rigenerabile
**/ops/**/dist/
# output di build: rigenerabile
**/ops/**/build/
# log di esecuzione: rumore, a volte dati personali
**/ops/**/logs/
# file temporanei
**/ops/**/tmp/
# cache di strumenti: rigenerabile
**/ops/**/.cache/
# bytecode Python: rigenerabile
**/ops/**/__pycache__/
# video: sempre fuori da git, a qualunque dimensione (kb_config.BLOCKED_EXTENSIONS; li rifiuta anche repo_check)
**/ops/**/*.mp4
**/ops/**/*.mov
**/ops/**/*.avi
**/ops/**/*.mkv
**/ops/**/*.webm
**/ops/**/*.m4v
# audio: sempre fuori da git, a qualunque dimensione (kb_config.BLOCKED_EXTENSIONS; li rifiuta anche repo_check)
**/ops/**/*.mp3
**/ops/**/*.wav
**/ops/**/*.flac
**/ops/**/*.m4a
**/ops/**/*.aac
**/ops/**/*.ogg
# archivio: sempre fuori da git, a qualunque dimensione (kb_config.BLOCKED_EXTENSIONS; li rifiuta anche repo_check)
**/ops/**/*.zip
**/ops/**/*.7z
**/ops/**/*.rar
**/ops/**/*.tar
**/ops/**/*.gz
**/ops/**/*.tgz
**/ops/**/*.bz2
**/ops/**/*.xz
**/ops/**/*.iso
# eseguibile o immagine disco: sempre fuori da git, a qualunque dimensione (kb_config.BLOCKED_EXTENSIONS; li rifiuta anche repo_check)
**/ops/**/*.exe
**/ops/**/*.msi
**/ops/**/*.dmg

# --- indice RAG: artefatti per-macchina, tranne gli stati condivisi (content-hash per file) ---
scripts/rag/index/*
!scripts/rag/index/*_state.json
!scripts/rag/index/state/
scripts/rag/qdrant_db/
scripts/rag/qdrant_server_storage/
qdrant-storage/
qdrant_storage/

# --- derivati rigenerabili e stato locale di Obsidian ---
_showcase/
.obsidian/workspace*.json

# --- file LOCALI di questa macchina (path assoluti): li rigenera scaffold/inizializza_clone.py
#     su ogni macchina che clona il brain; mai nel repo (SPEC v3.2 par. 12 G1) ---
.template-manifest.json
/brain.yaml
*.code-workspace
CLAUDE.md
AGENTS.md
/.env.example
**/.claude/settings.json
**/.claude/skills/
**/.agents/skills/
**/.codex/hooks.json
!**/ops/Projects/**/CLAUDE.md
!**/ops/Projects/**/AGENTS.md
